# Credentials
BANKING_USERNAME=your_username_here
BANKING_PASSWORD=your_password_here

# Banking Bot behavior
CHECK_INTERVAL=300          # seconds between balance checks
MAX_LOGIN_RETRIES=3         # stop after N consecutive login failures
HEADLESS=false              # true = no visible browser window
SLOW_MO=500                # ms delay between Playwright actions (debug)

# Paths
STORAGE_STATE=state.json

# --- Logging ---
LOG_LEVEL=DEBUG                       # Valid logging levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_FILE=logs/bot-execution.log
